# Databricks workspace configuration
DATABRICKS_HOST=your_databricks_workspace_host
DATABRICKS_TOKEN=your_databricks_token
DATABRICKS_JOB_ID=your_databricks_ingestion_job_id

# Required by the Airflow Compose configuration; replace with a unique random value.
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-a-unique-random-secret

# Local Airflow UI account; choose your own credentials before starting the stack.
_AIRFLOW_WWW_USER_USERNAME=change-me
_AIRFLOW_WWW_USER_PASSWORD=change-me
